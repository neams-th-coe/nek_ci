[GENERAL]
polynomialOrder = 5
startFrom = "bfs.fld"+time=0
stopAt = endTime
endTime = 0.005
dt = 1e-4
timeStepper = tombo2

checkpointControl = simulationTime 
checkpointInterval = 1.0
scalars = k,tau,cferr

[PROBLEMTYPE]
equation = navierStokes+variableViscosity

[FLUID PRESSURE]
residualTol = 1e-04

[FLUID VELOCITY]
boundaryTypeMap = v,O,W,W
residualTol = 1e-06
density = 1.0
viscosity = -149700.0

[SCALAR K]
boundaryTypeMap = t,I,t,t 
residualTol = 1e-08

[SCALAR TAU]
boundaryTypeMap = t,I,t,t 
residualTol = 1e-08

[SCALAR CFERR]
solver = none
