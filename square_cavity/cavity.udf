#ifdef __okl__

#include "cavity.oudf"

#endif

static dfloat T_cold;
static dfloat T_hot;
static dfloat Ri;

static occa::kernel buoyancyKernel;

void custom_source(dfloat time)
{
  auto mesh = nrs->meshV;

  //what momentum equation we want to add gravity to
  int component = 2;
  buoyancyKernel(mesh->Nelements, component * nrs->fieldOffset,  nrs->scalar->o_S, nrs->fluid->o_EXT);
}

void UDF_Setup0(MPI_Comm comm, setupAide &options)
{
  //get parameters from par file
  platform->par->extract("casedata", "T_cold", T_cold);
  platform->par->extract("casedata", "T_hot", T_hot);
  platform->par->extract("casedata", "Ri", Ri);
}

void UDF_LoadKernels(deviceKernelProperties & kernelInfo)
{
  //send parameter to device
  kernelInfo.define("p_T_cold") = T_cold;
  kernelInfo.define("p_T_hot") = T_hot;
  kernelInfo.define("p_Ri") = Ri;
  buoyancyKernel = oudfBuildKernel(kernelInfo, "buoyancy");
}

void UDF_Setup()
{
  auto mesh = nrs->meshV;

  // arbitrary array on the host where we will fill some initial data, which
  // we then copy to device
  std::vector<dfloat> temp(mesh->Nlocal, T_cold);
  nrs->scalar->o_solution("temperature").copyFrom(temp.data(), temp.size());

  //function pointer to add buyoancy term
  nrs->userSource = &custom_source;
}

void UDF_ExecuteStep(double time, int tstep)
{
}
