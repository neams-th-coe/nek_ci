# --------------------------------------
# Problem Parameters
# --------------------------------------
# Pr = 0.71
# Ra = 1e3, 1e4, 1e5, 1e6
# --------------------------------------
# X = L (characteristic length)
# U = alpha/L (characteristic velocity)
# x_bar = x/X = x/L
# u_bar = u/U = u*L/alpha
# Pe = U*X/alpha = alpha/L * L/alpha = 1
# Re = Pe / Pr = 1.4085
# Ri = Ra * Pr / Pe^2 = 0.71 * Ra
# --------------------------------------

userSections = CASEDATA

[OCCA]
  backend = CPU

[GENERAL]
  polynomialOrder = 3
  dt = targetCFL=2.0 + initial=1e-6
  stopAt = endTime
  endTime = 0.8
  checkpointControl = simulationTime
  checkpointInterval = 0.8
  scalars = temperature

[FLUID PRESSURE]
  residualTol = 1e-06

[FLUID VELOCITY]
  boundaryTypeMap = zeroDirichlet, zeroDirichlet, zeroDirichletY/zeroNeumann, zeroDirichletY/zeroNeumann, zeroDirichlet, zeroDirichlet
  residualTol = 1e-07
  density = 1
  viscosity = -1.4085

[SCALAR TEMPERATURE]
  boundaryTypeMap = udfDirichlet, udfDirichlet, zeroNeumann, zeroNeumann, zeroNeumann, zeroNeumann
  residualTol = 1e-07
  transportCoeff = 1
  diffusionCoeff = -1

[CASEDATA]
  Pr = 0.71
  Ra = 1e3
  Ri = 0.71e3
  T_cold = 0
  T_hot = 1
