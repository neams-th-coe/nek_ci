#include "ci.inc"

static deviceMemory<dfloat> o_nekFU;
static dfloat P_ROT;
static dfloat visc;

#ifdef __okl__

#include "channel.oudf"

#endif

void userf(double time)
{
  nrs->fluid->o_explicitTerms().copyFrom(o_nekFU, nrs->fluid->fieldOffsetSum);
}

void UDF_LoadKernels(deviceKernelProperties &kernelInfo)
{
  platform->options.getArgs("FLUID VISCOSITY", visc);
  kernelInfo.define("p_visc") = visc;
}

void UDF_Setup0(MPI_Comm comm, setupAide &options)
{
  options.getArgs("CI-MODE", ciMode);
  if (ciMode) {
    ciSetup(comm, options);
  }
  platform->par->extract("casedata", "p_rot", P_ROT);
  if (platform->options.compareArgs("BUILD ONLY", "FALSE"))
    *nek::ptr<double>("p_rot") = P_ROT;
}

void UDF_Setup()
{
  auto mesh = nrs->meshV;

  nrs->userSource = &userf;

  o_nekFU.resize(nrs->fluid->fieldOffsetSum);

  const dfloat DP = 3.0 * visc;
  cfill(mesh->Nlocal, nrs->fieldOffset, P_ROT, DP, o_nekFU);
}

void UDF_ExecuteStep(double time, int tstep)
{
}
