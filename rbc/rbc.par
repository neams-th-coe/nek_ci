[GENERAL]
polynomialOrder = 7
startFrom = rbc.fld + time=0
stopAt = endTime
endTime = 10.0
#stopAt = numSteps
#numSteps = 1
dt = targetCFL=2.0+initial=1e-5+max=5e-3
#dt = 1e-5
timeStepper = tombo2
advectionSubCyclingSteps = 2
checkpointControl = simulationTime
checkpointInterval = 10.0
regularization = hpfrt + nModes=1 + scalingCoeff=10
scalars = temperature, wtavg

[FLUID PRESSURE]
residualTol = 1e-4

[FLUID VELOCITY]
boundaryTypeMap = zeroDirichlet, zeroDirichlet
residualTol = 1e-6

[SCALAR TEMPERATURE]
boundaryTypeMap = udfDirichlet, udfDirichlet
residualTol = 1e-6

[SCALAR WTAVG]
solver = none
