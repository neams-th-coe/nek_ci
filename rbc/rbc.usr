c-----------------------------------------------------------------------
      subroutine usrdat2
      include 'SIZE'
      include 'TOTAL'

      integer iel,ifc

      do iel=1,nelv
        do ifc=1,2*ndim
          if (cbc(ifc,iel,1).eq.'W  ') then
            cbc(ifc,iel,2)='t  '
            if (ifc.eq.5) then
              boundaryID(ifc,iel)=1 !bottom wall
            elseif (ifc.eq.6) then
              boundaryID(ifc,iel)=2 !top wall
            endif
          endif
        enddo
      enddo

      return
      end
c-----------------------------------------------------------------------
