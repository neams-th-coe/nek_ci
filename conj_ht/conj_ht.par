userSections = CASEDATA

[GENERAL] 
#startFrom = "restart.fld"
polynomialOrder = 7
stopAt = endTime
endTime = 1.0
#numSteps = 3000
dt = 1e-03
timeStepper = tombo2

checkpointControl = simulationTime
checkpointInterval = 10

scalars = temperature

[FLUID PRESSURE]
residualTol = 1e-06

[FLUID VELOCITY]
boundaryTypeMap = v, O, W
residualTol = 1e-08

[SCALAR TEMPERATURE]
boundaryTypeMap = t, f, t, f, t, f, I
residualTol = 1e-08
mesh = fluid+solid

[CASEDATA]
P_PECLET = 1000.0
P_HEAT_SOURCE = 1.0
P_SOLID_CONDUCTIVITY_RATIO = 10.0
P_SOLID_HEIGHT_RATIO = 0.5
P_SOLID_HEAT_CAPACITY_RATIO = 0.1
P_VELOCITY_COEFFICIENT = 6.0
