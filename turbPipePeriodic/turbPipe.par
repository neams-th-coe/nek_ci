userSections = CASEDATA

[GENERAL]
#verbose = true
polynomialOrder = 5
#startFrom = "pipe.fld"+time=0
stopAt = endTime
endTime = 200.0

dt = targetCFL=4.0+initial=1e-3
timeStepper = tombo2
advectionSubCyclingSteps = 2

checkpointControl = simulationTime 
checkpointInterval = 100

regularization = hpfrt + nModes=1 + scalingCoeff=10
constFlowRate = meanVelocity=1.0 + direction=Z

[FLUID PRESSURE]
residualTol = 1e-04

[FLUID VELOCITY]
boundaryTypeMap = zeroDirichlet
viscosity = 1/19000
rho = 1.0
residualTol = 1e-06

[CASEDATA]
Re_tau = 550
zLength = 6
