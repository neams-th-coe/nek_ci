[Tests]
  [turb_pipe_periodic]
    type = CSVDiff
    input = nek.i
    csvdiff = nek_out.csv
    cli_args = '--nekrs-cimode 1'

    capabilities = 'nekrs'
    design = 'NekRSProblem.md NekRSMesh.md NekTimeStepper.md NekViscousSurfaceForce.md NekSideIntegral.md'

    min_parallel = 8
    max_time = 900
    # ~7500 MB, gives about 680/slot; number of slots must be larger than
    # number of ranks to be in effect
    min_slots = 11
    heavy = true

    issues = '#950'

    requirement = 'The system shall compute the friction velocity for fully developed turbulent flow in a periodic pipe and compare it against reference data.'
    verification = 'turbPipePeriodic.md'
  []
[]
